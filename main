        }

        button {
            padding: 12px 30px;
            font-size: 1.2rem;
            font-weight: 600;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            outline: none;
        }

        .btn-yes {
            background-color: #fbbd08; /* Amarelo Pompompurin */
            color: #6b4c3a; /* Texto marrom */
            box-shadow: 0 5px 15px rgba(251, 189, 8, 0.4);
            border: 2px solid #6b4c3a;
        }

        .btn-yes:hover {
            transform: scale(1.1);
