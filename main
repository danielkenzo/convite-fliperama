    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Fredoka', sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #fef0cd; /* Fundo amarelo pastel Pompompurin */
            overflow: hidden; /* Impede que a tela crie barra de rolagem quando o botão fugir */
        }

        .container {
            background-color: rgba(255, 255, 255, 0.95);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(139, 94, 52, 0.15); /* Sombra marrom suave */
            text-align: center;
            max-width: 90%;
            width: 400px;
            z-index: 10;
            border: 3px solid #6b4c3a; /* Bordinha marrom no estilo Sanrio */
        }

        .gif-container {
            margin-bottom: 20px;
        }

        .gif-container img {
            width: 200px;
            border-radius: 15px;
            pointer-events: none; /* Impede arrastar a imagem */
        }

        h1 {
            color: #6b4c3a; /* Marrom escuro Pompompurin */
            font-size: 1.8rem;
            margin-bottom: 10px;
        }

        p.details {
            color: #8b5e34; /* Marrom mais claro */
            font-size: 1.1rem;
            margin-bottom: 30px;
            line-height: 1.5;
        }

