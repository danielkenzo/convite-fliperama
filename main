<body>

    <div class="container" id="main-container">
        <div class="gif-container">
            <!-- GIF Inicial Pompompurin -->
            <img id="main-gif" src="https://media.tenor.com/VmOouMXHqTsAAAAj/pom-pom-purin-pompompurin.gif" alt="Pompompurin fofo">
        </div>
        
        <h1 id="title">Aceita sair comigo?</h1>
        <p class="details" id="message">
            Local: <strong>Game Station - Shopping Pátio Paulista</strong><br>
            Data: <strong>Sábado 17/10/2026 - 17h</strong>
        </p>

        <div class="buttons" id="btn-group">
            <button class="btn-yes" id="yesBtn">Sim!</button>
            <button class="btn-no" id="noBtn">Não</button>
        </div>
    </div>

    <script>
        const noBtn = document.getElementById('noBtn');
        const yesBtn = document.getElementById('yesBtn');
        const mainGif = document.getElementById('main-gif');
        const title = document.getElementById('title');
        const message = document.getElementById('message');
        const btnGroup = document.getElementById('btn-group');

        // Função para fazer o botão "Não" fugir
        function dodgeButton() {
            // Muda o botão para position fixed para poder circular pela tela toda
            noBtn.style.position = 'fixed';
            
            // Pega o tamanho da janela
            const windowWidth = window.innerWidth;
            const windowHeight = window.innerHeight;
            
            // Pega o tamanho do botão
            const btnWidth = noBtn.offsetWidth;
            const btnHeight = noBtn.offsetHeight;
            
            // Calcula uma posição aleatória segura (para não sair da tela)
            const randomX = Math.floor(Math.random() * (windowWidth - btnWidth));
            const randomY = Math.floor(Math.random() * (windowHeight - btnHeight));
            
            // Aplica a nova posição com uma transição rápida
            noBtn.style.left = `${randomX}px`;
            noBtn.style.top = `${randomY}px`;
        }

        // Eventos que disparam a fuga do botão
        noBtn.addEventListener('mouseover', dodgeButton);
        noBtn.addEventListener('mouseenter', dodgeButton);
        // touchstart é crucial para funcionar bem em celulares quando a pessoa tenta tocar
        noBtn.addEventListener('touchstart', function(e) {
            e.preventDefault(); // Evita o clique real
            dodgeButton();
        });

        // Caso a pessoa consiga clicar por um milagre, ele foge também
        noBtn.addEventListener('click', dodgeButton);

        // Ação do botão "Sim"
        yesBtn.addEventListener('click', function() {
            // Troca o GIF para um de comemoração Pompompurin
            mainGif.src = 'https://media1.tenor.com/m/p7AAYFLSjy0AAAAC/pompompurin-pom-pom.gif';
            
            // Muda os textos
            title.innerHTML = 'Combinado! ❤️';
            
            // Esconde os botões (incluindo o botão não que pode estar perdido pela tela)
            btnGroup.classList.add('hidden');
            noBtn.classList.add('hidden');
        });
    </script>
</body>
